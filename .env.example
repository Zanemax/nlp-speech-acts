# Google Gemini API key (Generative Language API).
# Get one at https://aistudio.google.com/apikey
#
# Local dev:   copy this file to `.env` and fill in the value, OR run
#              `netlify env:set GEMINI_API_KEY <your-key>`.
# Production:  set it in the Netlify UI (Site settings > Environment variables)
#              or with `netlify env:set GEMINI_API_KEY <your-key>`.
#
# This value is read ONLY inside the serverless function (netlify/functions/generate.mts)
# via Netlify.env.get("GEMINI_API_KEY"). It is never exposed to the browser.
GEMINI_API_KEY=
